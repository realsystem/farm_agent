# Local Development Environment Configuration
# Copy this to .env and fill in your values
# DO NOT commit .env to Git

# OpenAI API key for the agent
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Home Assistant long-lived access token for local development
# Create in HA: Settings → Devices & Services → (Your Name) → Create Token
# This is only needed for local development, not production
HA_TOKEN=
